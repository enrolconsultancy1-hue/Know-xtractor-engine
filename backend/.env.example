# KNOX configuration reference.
# Copy to `.env` and adjust; every value overrides the default in
# `app/core/config.py`. All keys are prefixed with KNOX_.

# --- Core ---------------------------------------------------------------
KNOX_APP_NAME=KNOX
KNOX_VERSION=0.1.0
KNOX_API_PREFIX=/api
# development | production  (production enables fail-fast validation)
KNOX_ENVIRONMENT=development

# --- Database -----------------------------------------------------------
# Dev default is SQLite. For production use Postgres, e.g.:
#   KNOX_DATABASE_URL=postgresql+psycopg://user:password@host:5432/knox
KNOX_DATABASE_URL=sqlite:///./data/knox.db

# --- Storage (relative to the backend working directory) ----------------
KNOX_DATA_DIR=data
KNOX_WORKSPACE_DIR=analysis_workspace
KNOX_PACKAGES_DIR=knowledge_packages
KNOX_EXPORTS_DIR=exports

# --- Analysis limits & resources ----------------------------------------
KNOX_MAX_FILE_SIZE_BYTES=2097152
KNOX_MAX_FILES_PER_ANALYSIS=20000
KNOX_MAX_ANALYSIS_DEPTH=3
KNOX_CLONE_TIMEOUT_SECONDS=600
KNOX_ANALYSIS_TIMEOUT_SECONDS=3600
KNOX_MAX_WORKERS=4

# --- Git acquisition ----------------------------------------------------
KNOX_ALLOW_NETWORK_CLONE=true

# --- CORS (explicit allowlist; never use "*" in production) -------------
KNOX_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Observability (Phase 4) --------------------------------------------
# text | json
KNOX_LOG_FORMAT=text
KNOX_LOG_LEVEL=INFO
KNOX_STALE_WORKSPACE_MAX_AGE_DAYS=7

# --- Rate limiting (Phase 7; 0 disables) ---------------------------------
KNOX_RATE_LIMIT_REQUESTS=60
KNOX_RATE_LIMIT_WINDOW_SECONDS=60

# --- Auth (Phase 2) -----------------------------------------------------
# none | token  (token = shared bearer key; users/JWT is a future extension)
KNOX_AUTH_MODE=none
# KNOX_API_KEY — required only when KNOX_AUTH_MODE=token

# --- Queue (Phase 3) ----------------------------------------------------
# inprocess (dev, no Redis needed) | rq (Redis-backed worker pool)
KNOX_QUEUE_BACKEND=inprocess
KNOX_REDIS_URL=redis://localhost:6379/0

# --- Optional AI reasoning (deterministic when unset) -------------------
KNOX_AI_PROVIDER=none
# KNOX_OPENAI_API_KEY — optional, leave unset for deterministic mode
# KNOX_ANTHROPIC_API_KEY — optional
# KNOX_GEMINI_API_KEY — optional
