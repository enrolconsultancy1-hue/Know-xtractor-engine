# Docker Compose deployment secrets.
#
# Copy this to `.env` (gitignored) and set real values before `docker compose up`.
#   cp .env.example .env

# Postgres password for the `knox` database user. Keep it URL-safe
# (avoid @ : / characters) — it is interpolated into KNOX_DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Shared bearer token for KNOX_AUTH_MODE=token.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
KNOX_API_KEY=change-me

# Opt-in logic capture: re-materializes verbatim function bodies into the
# knowledge package (source-of-record for byte-faithful rebuilds). OFF by
# default — it leaks source by design and only exists because the operator
# enables it. Bounds keep the package size predictable.
# KNOX_LOGIC_CAPTURE_ENABLED=0
# KNOX_LOGIC_CAPTURE_MAX_FUNCTIONS=200
# KNOX_LOGIC_CAPTURE_MAX_LINES_PER_FUNCTION=60
# KNOX_LOGIC_CAPTURE_INCLUDE_TESTS=0
